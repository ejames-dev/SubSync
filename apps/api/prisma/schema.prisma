datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

model Service {
  id            String                 @id
  name          String
  category      String
  supportsOAuth Boolean                @default(false)
  description   String?
  logoUrl       String?
  subscriptions Subscription[]
  receiptItems  EmailReceiptItem[]
  integration   IntegrationConnection?
}

model IntegrationConnection {
  providerId   String    @id
  status       String
  source       String
  connectedAt  DateTime  @default(now())
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt

  service Service @relation(fields: [providerId], references: [id], onDelete: Restrict)
}

model UserSettings {
  id                   String @id
  leadTimeDays         Int
  notificationChannels String
}

model Subscription {
  id                      String    @id @default(uuid())
  serviceId               String
  planName                String
  status                  String    @default("active")
  billingAmountCents      Int
  billingCurrency         String
  billingInterval         String    @default("monthly")
  nextRenewal             DateTime
  paymentSource           String?
  paymentLast4            String?
  autoImportSource        String?
  notes                   String?
  nextRenewalReminderSent Boolean   @default(false)
  snoozedUntil            DateTime?
  statusChangedAt         DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  importKey               String?   @unique
  lastImportedAt          DateTime?

  service              Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  events               SubscriptionEvent[]
  pendingNotifications PendingNotification[]
  receiptItems         EmailReceiptItem[]
}

model EmailReceipt {
  id                String    @id @default(uuid())
  source            String
  externalMessageId String?   @unique
  sender            String
  subject           String
  receivedAt        DateTime
  parserId          String?
  parserVersion     Int?
  status            String    @default("processing")
  overallConfidence Int       @default(0)
  bodyHash          String
  bodySnapshot      String?
  failureReason     String?
  createdAt         DateTime  @default(now())
  reviewedAt        DateTime?

  items EmailReceiptItem[]

  @@index([status, receivedAt])
}

model EmailReceiptItem {
  id             String   @id @default(uuid())
  receiptId      String
  serviceId      String?
  subscriptionId String?
  providerName   String
  planName       String
  amountCents    Int
  currency       String
  interval       String
  renewalDate    DateTime
  paymentSource  String?
  paymentLast4   String?
  confidence     Int
  action         String   @default("review")
  evidenceJson   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  receipt      EmailReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([action, confidence])
}

model PendingNotification {
  id             String    @id @default(uuid())
  subscriptionId String
  channel        String
  title          String
  body           String
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model SubscriptionEvent {
  id             String   @id @default(uuid())
  subscriptionId String
  eventType      String
  status         String
  notes          String?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id           String   @id
  leadTimeDays Int      @default(7)
  channels     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GmailConnection {
  id              String    @id @default("default")
  email           String?
  accessTokenEnc  String
  refreshTokenEnc String
  tokenExpiry     DateTime?
  scopes          String
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?
  updatedAt       DateTime  @updatedAt
}

model OAuthState {
  state     String   @id
  provider  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ProcessedGmailMessage {
  messageId   String   @id
  processedAt DateTime @default(now())
}
